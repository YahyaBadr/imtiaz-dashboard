# ═════════ Cloudflare Pages HTTP headers ═════════
# ملفات ثابتة (لوجوهات/خطوط): تخزين طويل — آمنة لأن أسماءها لا تتغير
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ملف الخدمة: يجب ألا يُخزّن أبداً حتى يلتقط المستخدم التحديثات فوراً
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/index.html
  Cache-Control: no-cache, must-revalidate

/*.js
  Cache-Control: no-cache, must-revalidate

/*.css
  Cache-Control: no-cache, must-revalidate

/manifest.json
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/manifest+json

# أمان إضافي
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-m61cXV0vjUbJA1Ak4HPGkWbKRm6xvz6mWG3hjpa7poo=; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
